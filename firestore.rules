rules_version = '2';

// ===============================================================
// Assumed Data Model (comptes Verso : profils, amis, messages)
// ===============================================================
//
// Collection: profiles            Document ID: uid de l'utilisateur
//   - handle: string (requis, 3-30, [a-z0-9._]) - pseudo unique (voir handles)
//   - name: string (requis, 0-50) - nom affiché
//   - bio: string (requis, 0-160)
//   - avatar: string (requis, "" ou data:image/jpeg;base64, < 120 000 car.)
//   - createdAt: timestamp (requis, immuable)
//   - updatedAt: timestamp (requis, = heure de la requête)
//   - visibility: string (optionnel, 'friends' | 'public') - qui voit les créations publiées
//   Profil public (aucune donnée personnelle : l'e-mail reste dans Firebase Auth).
//
// Collection: handles             Document ID: pseudo (minuscules)
//   - uid: string (requis, immuable) - propriétaire du pseudo
//
// Collection: friendRequests      Document ID: "<from>_<to>"
//   - from: string (requis, = auteur), to: string (requis, ≠ from)
//   - createdAt: timestamp (requis, = heure de la requête)
//
// Collection: friendships         Document ID: "<uidA>_<uidB>" (uidA < uidB)
//   - members: list<string> (requis, [uidA, uidB], immuable)
//   - createdAt: timestamp (requis, immuable)
//   - lastText: string (0-200), lastFrom: string, lastAt: timestamp (aperçu du dernier message)
//
// Sous-collection: friendships/{pairId}/messages   Document ID: auto
//   - from: string (requis, = auteur, membre de l'amitié)
//   - text: string (requis, 0-2000)
//   - image: string (optionnel, data:image/jpeg;base64, < 700 000 car.) - carte partagée
//   - song: map (optionnel, {title, artist} chaînes < 200) - morceau partagé
//   - createdAt: timestamp (requis, = heure de la requête)
//   Messages non modifiables ; l'auteur peut supprimer les siens.
//
// Collection: lyrics              Document ID: "<titre>__<artiste>" (a-z0-9 et -)
//   - title, artist: string (requis, 1-200, immuables) ; album: string (requis, 0-200, immuable)
//   - lyrics: string (requis, 1-20 000) - paroles partagées, modifiables par tous (wiki)
//   - by: string (requis, = dernier contributeur) ; byHandle: string (requis, 0-30, pseudo public)
//   - createdAt: timestamp (immuable) ; updatedAt: timestamp (= heure de la requête)
//   Jamais supprimé.
//
// Sous-collection: lyrics/{key}/revisions   Document ID: auto
//   - lyrics, by, byHandle, updatedAt : mêmes contraintes ; historique en ajout seul.
//
// Collection: posts               Document ID: identifiant de la carte (aléatoire)
//   - owner: string (requis, = auteur, immuable)
//   - image: string (requis, data:image/jpeg;base64, < 900 000 car.) - la carte
//   - title, artist: string (requis, 0-200) ; excerpt: string (requis, 0-1500)
//   - createdAt: timestamp (immuable) ; updatedAt: timestamp (= heure de la requête)
//   Modifiable pendant 3 h après la publication.
//   Visible par l'auteur, ses amis, et tout compte si le profil de l'auteur est « public ».
//
// Sous-collection: posts/{id}/likes      Document ID: uid de la personne qui aime
//   - postOwner: string (requis, = owner du post) ; createdAt: timestamp (= heure de la requête)
// Sous-collection: posts/{id}/comments   Document ID: auto
//   - from: string (= auteur) ; postOwner: string (= owner du post)
//   - text: string (requis, 1-500) ; createdAt: timestamp (= heure de la requête)
//   Supprimable par son auteur ou par l'auteur du post.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper Functions ----------
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function data() {
      return request.resource.data;
    }
    function hasOnlyAllowedFields(fields) {
      return data().keys().hasOnly(fields);
    }
    function isStr(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }
    function isUid(v) {
      return isStr(v, 1, 128);
    }
    function isValidHandle(h) {
      return isStr(h, 3, 30) && h.matches('^[a-z0-9._]+$');
    }
    function isValidAvatar(a) {
      return a == '' || (isStr(a, 1, 120000) && a.matches('^data:image/jpeg;base64,.*'));
    }

    // ---------- Domain Validators ----------
    function isValidProfile(uid) {
      return hasOnlyAllowedFields(['handle', 'name', 'bio', 'avatar', 'visibility', 'createdAt', 'updatedAt'])
        && (!('visibility' in data()) || data().visibility in ['friends', 'public'])
        && data().keys().hasAll(['handle', 'name', 'bio', 'avatar', 'createdAt', 'updatedAt'])
        && isValidHandle(data().handle)
        && isStr(data().name, 0, 50)
        && isStr(data().bio, 0, 160)
        && isValidAvatar(data().avatar)
        && data().createdAt is timestamp
        && data().updatedAt == request.time
        // Le pseudo doit être réservé à son nom (dans la même écriture groupée ou avant).
        && getAfter(/databases/$(database)/documents/handles/$(data().handle)).data.uid == uid;
    }
    function isValidFriendRequest(from, to) {
      return hasOnlyAllowedFields(['from', 'to', 'createdAt'])
        && data().from == from && data().to == to
        && isUid(to) && from != to
        && data().createdAt == request.time;
    }
    function isMember(pairId) {
      return isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pairId)).data.members;
    }
    function isValidMessage() {
      return hasOnlyAllowedFields(['from', 'text', 'image', 'song', 'createdAt'])
        && data().keys().hasAll(['from', 'text', 'createdAt'])
        && data().from == request.auth.uid
        && isStr(data().text, 0, 2000)
        && (!('image' in data()) || (isStr(data().image, 1, 700000) && data().image.matches('^data:image/jpeg;base64,.*')))
        && (!('song' in data()) || (data().song is map && data().song.keys().hasOnly(['title', 'artist'])
              && isStr(data().song.title, 1, 200) && isStr(data().song.artist, 0, 200)))
        && data().createdAt == request.time;
    }

    function isValidLyricsEdit() {
      return isStr(data().lyrics, 1, 20000)
        && data().by == request.auth.uid
        && isStr(data().byHandle, 0, 30)
        && data().updatedAt == request.time;
    }
    function isValidLyrics() {
      return hasOnlyAllowedFields(['title', 'artist', 'album', 'lyrics', 'by', 'byHandle', 'createdAt', 'updatedAt'])
        && data().keys().hasAll(['title', 'artist', 'album', 'lyrics', 'by', 'byHandle', 'createdAt', 'updatedAt'])
        && isStr(data().title, 1, 200) && isStr(data().artist, 1, 200) && isStr(data().album, 0, 200)
        && data().createdAt is timestamp
        && isValidLyricsEdit();
    }

    // L'utilisateur connecté peut-il voir les publications de « owner » ?
    function canSeePostsOf(owner) {
      return isAuthenticated() && (
        request.auth.uid == owner
        || exists(/databases/$(database)/documents/friendships/$(request.auth.uid < owner ? request.auth.uid + '_' + owner : owner + '_' + request.auth.uid))
        || get(/databases/$(database)/documents/profiles/$(owner)).data.get('visibility', 'friends') == 'public');
    }
    function postOwner(postId) {
      return get(/databases/$(database)/documents/posts/$(postId)).data.owner;
    }
    function isValidPost() {
      return hasOnlyAllowedFields(['owner', 'image', 'title', 'artist', 'excerpt', 'createdAt', 'updatedAt'])
        && data().keys().hasAll(['owner', 'image', 'title', 'artist', 'excerpt', 'createdAt', 'updatedAt'])
        && data().owner == request.auth.uid
        && isStr(data().image, 1, 900000) && data().image.matches('^data:image/jpeg;base64,.*')
        && isStr(data().title, 0, 200) && isStr(data().artist, 0, 200) && isStr(data().excerpt, 0, 1500)
        && data().createdAt is timestamp
        && data().updatedAt == request.time;
    }

    // ---------- Créations publiées, j'aime et commentaires ----------
    match /posts/{postId} {
      allow read: if canSeePostsOf(resource.data.owner);
      allow create: if isAuthenticated() && isValidPost() && data().createdAt == request.time;
      // Modifiable pendant 3 heures après la publication, puis figée.
      allow update: if isAuthenticated() && resource.data.owner == request.auth.uid && isValidPost()
        && data().createdAt == resource.data.createdAt
        && request.time < resource.data.createdAt + duration.value(3, 'h');
      allow delete: if isAuthenticated() && resource.data.owner == request.auth.uid;

      match /likes/{uid} {
        allow read: if canSeePostsOf(postOwner(postId));
        allow create: if isOwner(uid) && canSeePostsOf(postOwner(postId))
          && hasOnlyAllowedFields(['postOwner', 'createdAt'])
          && data().postOwner == postOwner(postId) && data().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(uid);
      }
      match /comments/{commentId} {
        allow read: if canSeePostsOf(postOwner(postId));
        allow create: if isAuthenticated() && canSeePostsOf(postOwner(postId))
          && hasOnlyAllowedFields(['from', 'postOwner', 'text', 'createdAt'])
          && data().keys().hasAll(['from', 'postOwner', 'text', 'createdAt'])
          && data().from == request.auth.uid && data().postOwner == postOwner(postId)
          && isStr(data().text, 1, 500) && data().createdAt == request.time;
        allow update: if false;
        allow delete: if isAuthenticated()
          && (resource.data.from == request.auth.uid || resource.data.postOwner == request.auth.uid);
      }
    }

    // Activité sur mes publications (j'aime et commentaires reçus), pour les alertes.
    match /{path=**}/likes/{uid} {
      allow read: if isAuthenticated() && resource.data.postOwner == request.auth.uid;
    }
    match /{path=**}/comments/{commentId} {
      allow read: if isAuthenticated() && resource.data.postOwner == request.auth.uid;
    }

    // ---------- Paroles partagées (collaboratives) ----------
    match /lyrics/{key} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && key.size() <= 300 && key.matches('^[a-z0-9-]+__[a-z0-9-]+$')
        && isValidLyrics() && data().createdAt == request.time;
      allow update: if isAuthenticated() && isValidLyrics()
        && data().diff(resource.data).affectedKeys().hasOnly(['lyrics', 'by', 'byHandle', 'updatedAt']);
      allow delete: if false;

      match /revisions/{revId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && hasOnlyAllowedFields(['lyrics', 'by', 'byHandle', 'updatedAt'])
          && data().keys().hasAll(['lyrics', 'by', 'byHandle', 'updatedAt'])
          && isValidLyricsEdit()
          && existsAfter(/databases/$(database)/documents/lyrics/$(key));
        allow update, delete: if false;
      }
    }

    // ---------- Profils publics ----------
    match /profiles/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) && isValidProfile(uid);
      allow update: if isOwner(uid) && isValidProfile(uid)
        && data().createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }

    // ---------- Pseudos uniques ----------
    match /handles/{handle} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidHandle(handle)
        && hasOnlyAllowedFields(['uid']) && data().uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ---------- Demandes d'ami ----------
    match /friendRequests/{reqId} {
      allow read: if isAuthenticated()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isAuthenticated()
        && reqId == request.auth.uid + '_' + data().to
        && isValidFriendRequest(request.auth.uid, data().to)
        && exists(/databases/$(database)/documents/profiles/$(data().to));
      allow update: if false;
      allow delete: if isAuthenticated()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // ---------- Amitiés (créées en acceptant une demande) ----------
    match /friendships/{pairId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated()
        && hasOnlyAllowedFields(['members', 'createdAt'])
        && data().members is list && data().members.size() == 2
        && isUid(data().members[0]) && isUid(data().members[1])
        && data().members[0] < data().members[1]
        && pairId == data().members[0] + '_' + data().members[1]
        && request.auth.uid in data().members
        && data().createdAt == request.time
        // Seul le destinataire d'une demande existante peut l'accepter.
        && exists(/databases/$(database)/documents/friendRequests/$(
             (data().members[0] == request.auth.uid ? data().members[1] : data().members[0]) + '_' + request.auth.uid));
      // Mise à jour réservée à l'aperçu du dernier message, par un membre.
      allow update: if isAuthenticated() && request.auth.uid in resource.data.members
        && data().diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastFrom', 'lastAt'])
        && hasOnlyAllowedFields(['members', 'createdAt', 'lastText', 'lastFrom', 'lastAt'])
        && isStr(data().lastText, 0, 200)
        && data().lastFrom == request.auth.uid
        && data().lastAt == request.time;
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if isMember(pairId);
        allow create: if isMember(pairId) && isValidMessage();
        allow update: if false;
        allow delete: if isMember(pairId) && resource.data.from == request.auth.uid;
      }
    }
  }
}
